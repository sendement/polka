# Maintainer: Sendem <18467008+sendement@users.noreply.github.com>
pkgname=polka
pkgver=0.19.2
pkgrel=1
pkgdesc="Gamepad-first file manager: dual pane, archives as folders, themed and .exe icons"
arch=('x86_64')
url="https://github.com/sendement/polka"
license=('MIT')
depends=(
  'libarchive'
  'xz'
  'zstd'
  'systemd-libs'     # libudev, gamepad hotplug
  'gcc-libs'
  'glibc'
  # loaded at runtime by winit/glow
  'libxkbcommon'
  'wayland'
  'libglvnd'
  'alsa-lib'         # sound output (PipeWire/Pulse through their ALSA plugins)
  'fontconfig'       # system UI font lookup
  'hicolor-icon-theme'
  'xdg-utils'        # opening files with their default apps
)
optdepends=(
  'curl: pictures from the internet in Markdown'
  'udisks2: mounting, unmounting and ejecting drives from the sidebar'
  'noto-fonts-cjk: Chinese, Japanese and Korean text'
  'ffmpeg: video player and thumbnails; Opus, WMA, APE and other audio formats'
  '7zip: password-protected 7z and rar archives'
  'papirus-icon-theme: a complete icon theme, if yours lacks mime icons'
)
makedepends=('cargo')
# Rust links with lld here; GCC LTO objects from C build scripts break that.
options=('!lto')
# Local snapshot made by make-tarball.sh; switch to the GitHub tag tarball
# once the repository is public.
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  # Keep the registry inside $srcdir so --remap-path-prefix hides it.
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/build"
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/build"
  POLKA_NO_GAMEPAD=1 cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/polka "$pkgdir/usr/bin/polka"
  install -Dm644 packaging/polka.desktop "$pkgdir/usr/share/applications/polka.desktop"
  install -Dm644 packaging/polka.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/polka.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
